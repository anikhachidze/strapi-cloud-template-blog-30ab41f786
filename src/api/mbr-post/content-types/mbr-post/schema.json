{
  "kind": "collectionType",
  "collectionName": "mbr_posts",
  "info": {
    "singularName": "mbr-post",
    "pluralName": "mbr-posts",
    "displayName": "MindBody Post",
    "description": "Localized MindBody Roots blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true
    },
    "title": {
      "type": "json",
      "required": true
    },
    "category": {
      "type": "json"
    },
    "date": {
      "type": "string"
    },
    "readingTime": {
      "type": "json"
    },
    "excerpt": {
      "type": "json"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "productTitles": {
      "type": "json"
    },
    "sections": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
